		{
			"name": "POST Create Post",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response contains the created post\", function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json).to.have.property(\"title\", \"My first QA post\");",
							"    pm.expect(json).to.have.property(\"body\", \"Learning API testing step by step\");",
							"    pm.expect(json).to.have.property(\"userId\", 1);",
							"});",
							"",
							"pm.test(\"Response contains an id\", function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json).to.have.property(\"id\");",
							"    pm.expect(json.id).to.be.a(\"number\");",
							"});",
							"",
							"// Save the id to the environment",
							"const json = pm.response.json();",
							"pm.environment.set(\"postId\", json.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"My first QA post\",\n  \"body\": \"Learning API testing step by step\",\n  \"userId\": 1\n}",
